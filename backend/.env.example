# ALOP-AI backend configuration.
# Copy to .env and fill in. Never commit the filled-in copy.
#
# EVERY VARIABLE THE CODE READS IS LISTED HERE, and env-example.test.js fails if
# one is added without being documented. That test exists because this file had
# drifted six variables behind the code, and the only way anyone learned about
# ALLOWED_ORIGINS or TERMINAL_SECRET was being told.

# ---- Required: the server refuses to boot without these ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=   # pk_test_… on a development instance, pk_live_… on production
FRONTEND_URL=            # exact origin of the frontend; used for CORS and Stripe redirects
OPENROUTER_HOST=        # base URL of the OpenRouter chat-completions endpoint
OPENROUTER_API_KEY=

# ---- CORS ----
#
# The allowlist is host-parsed, never substring-matched. FRONTEND_URL is always
# allowed; these add to it.

# Other exact origins this deployment answers on, comma-separated. Vercel serves
# one project on several aliases joined by HYPHENS, so no suffix rule can cover
# them and they have to be listed.
ALLOWED_ORIGINS=

# Host suffixes, comma-separated. Each MUST begin with a separator:
#   ".foo.example"                  a real subdomain — strongest
#   "-myteam-projects.vercel.app"   Vercel preview deployments
# Leaving this unset means preview deployments cannot call the API, which
# presents as "Failed to create chat". A "-" suffix is weaker than a "." one;
# lib/origin-guard.js says exactly how much weaker and why it is acceptable here.
ALLOWED_ORIGIN_SUFFIXES=

# ---- Optional: each feature disables itself if its keys are absent ----

# Billing. Both price IDs must be set or /api/billing/prices returns 503 and the
# upgrade path hides itself rather than rendering a paywall that fails at
# checkout. Amount and currency come from Stripe, not from this codebase.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Error reporting. Unset means Sentry is a no-op (a boot warning is logged).
SENTRY_DSN=

# Screen-capture vision in the desktop overlay. Unset means images are ignored.
GOOGLE_API_KEY=

# Web search sources. Any subset works; the server uses whichever are present.
BRAVE_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# Perplexity Sonar. The only source that returns a written, cited answer rather
# than links — worth having for market research and news. Unset means the
# provider is skipped and nothing else changes. PERPLEXITY_MODEL defaults to
# `sonar`; `sonar-pro` researches harder and costs more per call.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=

# Serper (serper.dev). Google Shopping as structured data: title, price,
# merchant, link. The five web providers return links and prose, which is why
# the app could name five monitors and not one price — see lib/shopping.js.
# Called only when the question is about buying something, because Serper bills
# per query. Unset means the provider is skipped and nothing else changes.
# Coverage is thin outside the US and EU; the prompt block says so itself.
SERPER_API_KEY=

# SerpApi. ~110 "APIs" on their dashboard are ONE endpoint with a different
# `engine=` — Google Flights, Yelp Reviews, Scholar, Amazon, Trends and the
# rest — so they arrive as one council tool with an engine argument rather than
# 110 tools. See lib/serpapi.js for why that distinction is not cosmetic.
# Billed per search with a 100/month free tier, which is a couple of talkative
# conversations: the agent loop's 8-call ceiling is what bounds the spend.
SERPAPI_API_KEY=

# Firecrawl. A real browser, used ONLY when the cheap reader came back blind.
# Jina fetches and converts a document, so it cannot see a price that JavaScript
# paints in after load — which is every large retailer, and the actual root of
# the "five monitors, no prices" answer. Unset means no fallback and reads
# behave exactly as before.
FIRECRAWL_API_KEY=

# How many search results get a full page read. Default 3. The reads are
# concurrent under one deadline, so the wall clock is the slowest read whatever
# this is set to — but each one is a Jina call, which is why it is bounded.
PAGE_READ_LIMIT=

# ---- Council tool calling ----
#
#   unset / 0   off — the router path, untouched
#   shadow      probe one round, log the result, discard it; answers unchanged
#   1           live
#
# `shadow` answers the only question that decides whether it is safe to enable:
# do these models emit a parseable tool_call block? Read the [PROBE] lines for a
# day before flipping to 1.
COUNCIL_TOOLS=

# ---- Rate limiting ----
#
# Unset means an in-memory store, which is PER PROCESS. Every limit multiplies
# by the instance count, so "120 per minute" becomes 240 on two instances.
# SET THIS TO 'postgres' BEFORE SCALING PAST ONE INSTANCE. Needs
# migrations/004_rate_limits.sql applied.
RATE_LIMIT_STORE=

# How long a cached search stays usable, in milliseconds. Default 900000
# (15 minutes). Optional — the cache works without this set.
#
# The trade-off is staleness, not correctness: a longer TTL serves more
# answers instantly but can hand back a price or a headline that has moved.
# Raise it to make the app feel faster; lower it if answers start looking out
# of date. Needs migrations/005_search_cache.sql applied for the tier that
# survives a deploy — without it the cache silently stays in-process, which is
# the behaviour it had before.
SEARCH_CACHE_TTL_MS=

# How long the `users` row is held in memory, in milliseconds. Default 15000.
#
# checkSuspended ran a Supabase select at the front of every authenticated
# request, before any work started, so it was latency the user watched. The
# cache removes it.
#
# This is a backstop, not the mechanism: suspending a user, deleting a user and
# every Stripe plan change clear the cache outright, so those take effect on the
# next request rather than after the TTL. Raising this does not delay them.
# Leave it alone unless you are debugging a staleness question.
USER_ROW_TTL_MS=

# How often a user's Clerk profile is refreshed in the background, in
# milliseconds. Default 600000 (10 minutes).
#
# This used to happen on EVERY request: a call to Clerk's API plus a Postgres
# write, to store a display name and avatar that change roughly never. It was
# fire-and-forget, so it never showed up in the response time — it was still a
# round trip per request against Clerk's rate limit.
#
# What it delays is a name or avatar edited in Clerk showing up here. Nothing
# about auth, plan or suspension travels this path.
PROFILE_REFRESH_MS=

# How long audit log rows are kept, in days. Default 90.
#
# audit_logs.ip_address is personal data. GDPR Art. 5(1)(e) requires it to be
# kept no longer than necessary, and the published privacy policy states 90
# days — so if you change this, change the policy with it. A retention period
# the database does not honour is a false public statement.
#
# Needs migrations/006_audit_retention.sql applied. Without it the sweep is a
# no-op and rows are kept forever.
AUDIT_RETAIN_DAYS=

# ---- Admin console ----
#
# Disabled unless BOTH are set — an unconfigured security control must never be
# an open one. See docs/ADMIN-CONSOLE.md.
#
# Comma-separated Clerk user ids. This is what makes the console one person's:
# is_admin is a database column and anything that can write to that table can
# grant it, whereas this lives in the environment.
TERMINAL_ADMINS=
# 24 characters minimum; a shorter one counts as unconfigured because it looks
# configured. Generate with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
TERMINAL_SECRET=

# ---- Speech ----
#
# Entirely optional. Without a key, /api/speech answers 501 and the client
# reads answers aloud with the browser's own voice — free, offline, and worse.
# With one, the same button gets a voice that sounds like a person.
#
# https://fish.audio -> API keys.
FISH_AUDIO_API_KEY=
# Defaults to s2.1-pro-free, which is the same model at $0 with no latency
# guarantee. Set to s2.1-pro to pay for one.
FISH_AUDIO_MODEL=
# A voice id from the Fish Audio dashboard. Unset uses their default voice,
# which is why the feature works the moment the key is set.
FISH_AUDIO_VOICE_ID=

# ---- Runtime ----
NODE_ENV=development     # 'production' masks 5xx bodies and cuts Sentry sampling to 10%
PORT=3001

# ---- Per-user spend ceiling ----
# $5/day and $20/month per user, the owner's figures, 2026-08-12. Enforced in
# cents by an atomic reservation before the first paid call on /api/council,
# refunded down to what the turn actually cost.
#
# UNSET IS NOT OFF. Every variable here has a default in lib/spend.js and the
# ceiling is always on; there is deliberately no variable that disables it.
# Unset SPEND_DAY_CENTS means 500 ($5) and SPEND_MONTH_CENTS means 2000 ($20).
# The month is not 30x the day on purpose: the day caps a bad day, the month
# caps a sustained one, so the month binds first past about four heavy days.
SPEND_DAY_CENTS=
SPEND_MONTH_CENTS=
#
# What a turn is priced at, in TENTHS of a cent per operation. ESTIMATES, not a
# bill: nothing here meters tokens, so a turn is priced by what the telemetry
# says it DID — seats asked, whether it synthesised, tool calls made. Compare
# against the provider dashboards and correct them here; that is what these are
# for. Defaults when unset: seat 4, synthesis 5, fast 1, search 4, fetch 1,
# which puts a seven-seat turn at roughly 3.3 cents.
SPEND_SEAT_TENTHS=
SPEND_SYNTHESIS_TENTHS=
SPEND_FAST_TENTHS=
SPEND_SEARCH_TENTHS=
SPEND_FETCH_TENTHS=
#
# THE REQUEST CEILING, WHICH IS THE ONE THAT ACTUALLY BINDS. Counted in
# OpenRouter requests per UTC day, not in money — a `:free` model call costs $0,
# so the cents ceiling above cannot bind on a model and now guards only search
# and page fetches. Search calls do NOT consume this quota; they go to Brave,
# Tavily, Serper, Google CSE and r.jina.ai rather than to OpenRouter.
#
# ACCOUNT-WIDE, NOT PER USER. Unlike every other ceiling in this file, all users
# share one pool, so one user can exhaust the day for everyone. The counter this
# feeds must be global — keying it per user, by analogy with the spend limiters
# above, enforces the cap at N times its real size.
#
# THE DEFAULT ASSUMES CREDITS HAVE BEEN BOUGHT. Unset SPEND_DAY_REQUESTS means
# 1000, which is the allowance AFTER $10 of credits. A zero-credit account gets
# 50 per day — about five council turns for the whole product — so if credits
# have not been added, SET THIS TO 50. Left at the default on a zero-credit
# account this ceiling never fires and OpenRouter's own 429 is the only thing
# enforcing the limit, which is the situation the module exists to get ahead of.
# Both figures are measured, from a live 429 carrying X-RateLimit-Limit: 50.
#
# SPEND_WARN_REQUESTS is a soft mark for reporting, default 800, not enforced.
# There is no monthly variable on purpose: the provider's cap is purely daily and
# resets at UTC midnight, so a month here would be our invention, not their rule.
SPEND_DAY_REQUESTS=
SPEND_WARN_REQUESTS=
#
# The FAST_MODEL calls a council turn makes outside the council — the router's
# classification, the chat title, the feedback note — which spend quota but never
# appear in a telemetry seat record. Default 3. If a fourth short call is ever
# added to a turn, this is the line that has to move or every turn is
# under-counted against the ceiling above.
SPEND_FAST_OVERHEAD=

# ---- Set by the host, not by you ----

# WHICH COMMIT IS LIVE, reported by /health so that "is it deployed" is a fact
# rather than an inference. Render sets RENDER_GIT_COMMIT automatically on every
# deploy and you should leave it unset here; GIT_COMMIT is the manual fallback
# for hosts that do not, and both fall back to "unknown".
#
# It exists because a 200 from /health proves only that SOMETHING is serving.
# Render keeps the previous deployment alive when a new one fails to boot, so a
# healthy old build is indistinguishable from a healthy new one — which cost two
# separate investigations on 2026-08-12, both ending at "cannot tell from here".
# Safe to expose: the repository is public, so the SHA names a commit anyone can
# already read.
RENDER_GIT_COMMIT=
GIT_COMMIT=
