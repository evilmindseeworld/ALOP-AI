{
  "name": "backend-intelligence-v2",
  "notes": [
    "Fresh P1 candidate manifest derived one-for-one from backend-intelligence-v1; the historical v1 manifest remains unchanged.",
    "The user-text-summary case uses a bounded semantic relation matcher for worker retry, lease ownership, and reclaim after expiry rather than literal keyword stems.",
    "Factuality is a separate assertion suite. It counts only stable, model-involved cases and does not freeze current prices, runtime releases, or weather.",
    "The five stable factuality cases carry six explicit assertions with adversarial forbidden patterns; arithmetic and deterministic no-model cases are not model factuality evidence."
  ],
  "cases": [
    {
      "id": "simple-fact-japan-capital",
      "question": "What is the capital of Japan?",
      "tags": ["simple factual", "search-not-required", "full-council-overkill"],
      "expect": { "mustInclude": ["Tokyo"], "expectNoTools": true, "maxLatencyMs": 30000 },
      "factualityChecks": {
        "modelInvolved": true,
        "stableWhy": "The capital of Japan is a stable geography fact, not a current or account-dependent observation.",
        "assertions": [
          {
            "id": "japan-capital-tokyo",
            "claim": "Japan's capital is Tokyo.",
            "patterns": [
              "^\\s*tokyo\\s*[.!]?\\s*$",
              "\\b(?:capital|capital city)\\b[^.!?;]{0,80}\\b(?:of\\s+)?japan\\b[^.!?;]{0,80}\\b(?:is|called)\\b[^.!?;]{0,40}\\btokyo\\b",
              "\\btokyo\\b[^.!?;]{0,60}\\b(?:is|serves as)\\b[^.!?;]{0,50}\\b(?:the\\s+)?capital\\b[^.!?;]{0,50}\\bof\\s+japan\\b",
              "\\bjapan(?:['’]s)?\\b[^.!?;]{0,45}\\b(?:capital|capital city)\\b[^.!?;]{0,50}\\b(?:is|called)\\b[^.!?;]{0,35}\\btokyo\\b"
            ],
            "forbiddenPatterns": [
              "\\b(?:tokyo|japan)\\b[^.!?;]{0,70}\\b(?:is|are|was|were)\\s+not\\b[^.!?;]{0,80}\\b(?:the\\s+)?capital\\b",
              "\\btokyo\\b[^.!?;]{0,80}\\b(?:is|serves as)\\b[^.!?;]{0,50}\\b(?:the\\s+)?capital\\b[^.!?;]{0,50}\\bof\\s+(?!japan\\b)[a-z]+\\b",
              "\\bjapan(?:['’]s)?\\b[^.!?;]{0,45}\\b(?:capital|capital city)\\b[^.!?;]{0,50}\\b(?:is|called)\\b[^.!?;]{0,35}\\b(?:osaka|kyoto|paris|london)\\b",
              "\\b(?:capital|capital city)\\b[^.!?;]{0,80}\\b(?:of\\s+)?japan\\b[^.!?;]{0,80}\\b(?:is|are|was|were)\\s+(?:osaka|kyoto|paris|london)\\b"
            ]
          }
        ]
      }
    },
    {
      "id": "simple-explanation-photosynthesis",
      "question": "What is photosynthesis? Explain it in two sentences.",
      "tags": ["simple explanation", "search-not-required"],
      "expect": { "mustMatch": ["plant|chlorophyll|light|energy"], "expectNoTools": true, "minChars": 60, "maxLatencyMs": 30000 },
      "factualityChecks": {
        "modelInvolved": true,
        "stableWhy": "The role of chlorophyll and light energy in plant photosynthesis is an established biology fact.",
        "assertions": [
          {
            "id": "photosynthesis-chlorophyll-light",
            "claim": "Plants use chlorophyll to capture or use light energy in photosynthesis.",
            "patterns": [
              "\\bphotosynthesis\\b[\\s\\S]{0,260}\\bchlorophyll\\b[\\s\\S]{0,80}\\b(?:capture|captures|absorb|absorbs|use|uses|harness)\\b[\\s\\S]{0,80}\\b(?:light|sunlight|solar)\\b",
              "\\bplants?\\b[^.!?;]{0,60}\\b(?:use|uses|using)\\b[^.!?;]{0,50}\\bchlorophyll\\b[^.!?;]{0,100}\\b(?:capture|absorb|harness|convert)\\b[^.!?;]{0,60}\\b(?:light|solar)\\b"
            ],
            "forbiddenPatterns": [
              "\\b(?:plants?|photosynthesis)\\b[^.!?;]{0,160}\\b(?:do|does|did|not|never|no)\\b[^.!?;]{0,100}\\b(?:use|involve|need|release|produce)\\b[^.!?;]{0,100}\\b(?:chlorophyll|oxygen|light)\\b",
              "\\b(?:plants?|photosynthesis)\\b[^.!?;]{0,180}\\b(?:no|not|never|without)\\s+(?:oxygen|chlorophyll|light)\\b",
              "\\b(?:animals?|rocks?|bacteria)\\b[^.!?;]{0,80}\\b(?:use|uses)\\b[^.!?;]{0,50}\\bchlorophyll\\b",
              "\\b(?:photosynthesis|plants?)\\b[\\s\\S]{0,220}\\b(?:melanin|carotene|other\\s+pigment)\\b[\\s\\S]{0,80}\\b(?:rather\\s+than|instead\\s+of)\\b[\\s\\S]{0,60}\\bchlorophyll\\b",
              "\\b(?:photosynthesis|plants?)\\b[\\s\\S]{0,260}\\bchlorophyll\\b[\\s\\S]{0,80}\\b(?:plays?\\s+no\\s+role|is\\s+unrelated|not\\s+related|not\\s+involved)\\b",
              "\\b(?:photosynthesis|plants?)\\b[\\s\\S]{0,260}\\b(?:convert|capture|use|uses|harness)\\b[\\s\\S]{0,120}\\b(?:light|sunlight|solar)\\s+energy\\b[\\s\\S]{0,120}\\b(?:without|no|not)\\s+(?:the\\s+)?chlorophyll\\b"
            ]
          }
        ]
      }
    },
    {
      "id": "moderate-cache-tradeoff",
      "question": "Why can a cache make an application faster while still making its answers wrong?",
      "tags": ["moderate reasoning", "evidence-sensitive"],
      "expect": { "mustMatch": ["(?:\\bcach(?:e|ed|ing|es)\\b[\\s\\S]{0,160}\\b(?:faster|speed|latency|performance)\\b|\\b(?:faster|speed|latency|performance)\\b[\\s\\S]{0,160}\\bcach(?:e|ed|ing|es)\\b)", "stale|out of date|invalidat"], "minChars": 100, "maxLatencyMs": 75000 },
      "factualityChecks": {
        "modelInvolved": true,
        "stableWhy": "The speed benefit and freshness risk of cached data are stable systems concepts independent of current prices or releases.",
        "assertions": [
          {
            "id": "cache-reduces-latency",
            "claim": "A cache can improve speed or reduce latency by serving a stored result.",
            "patterns": [
              "\\bcach(?:e|es|ed|ing)\\b[^.!?;]{0,120}\\b(?:faster|speed|latency|performance|quick)\\b",
              "\\b(?:faster|speed|latency|performance|quick)\\b[^.!?;]{0,120}\\bcach(?:e|es|ed|ing)\\b"
            ],
            "forbiddenPatterns": [
              "\\bcach(?:e|es|ed|ing)\\b[^.!?;]{0,100}\\b(?:does not|doesn't|never|not)\\b[^.!?;]{0,80}\\b(?:improve|reduce|speed|faster)\\b"
            ]
          },
          {
            "id": "cache-freshness-risk",
            "claim": "A stale cache can return wrong or outdated data, so invalidation or refresh matters.",
            "patterns": [
              "\\bcach(?:e|es|ed|ing)\\b[^.!?;]{0,160}\\b(?:stale|out\\s+of\\s+date|old)\\b",
              "\\b(?:stale|out\\s+of\\s+date)\\b[^.!?;]{0,100}\\b(?:cache|cached|caching)\\b",
              "\\b(?:invalidation|refresh|freshness)\\b[^.!?;]{0,100}\\b(?:stale|old|out\\s+of\\s+date|wrong|incorrect)\\b"
            ],
            "forbiddenPatterns": [
              "\\b(?:stale|out\\s+of\\s+date)\\b[^.!?;]{0,100}\\b(?:not|never)\\b[^.!?;]{0,80}\\b(?:wrong|problem|harm)\\b",
              "\\bcach(?:e|es|ed|ing)\\b[^.!?;]{0,120}\\b(?:never|does not|doesn't|cannot|can't)\\b[^.!?;]{0,100}\\b(?:stale|wrong|incorrect|invalidate|refresh)\\b"
            ]
          }
        ]
      }
    },
    {
      "id": "hard-replica-decision",
      "question": "Should a two-person team put a Postgres read replica in front of an app serving 30 requests a minute? Compare the trade-offs and recommend a decision.",
      "tags": ["hard reasoning", "comparison", "decision", "full-council-justified"],
      "expect": { "mustMatch": ["no|not yet|wait|recommend", "latency|complexity|cost|consistency"], "minChars": 220, "maxLatencyMs": 75000 }
    },
    {
      "id": "multi-step-break-even",
      "question": "A database query takes 200 ms and runs 120 times per minute. A cache hit takes 5 ms but misses 20% of the time. Estimate the average latency and explain the operational trade-off.",
      "tags": ["multi-step analysis", "moderate reasoning", "evidence-sensitive"],
      "expect": { "mustMatch": ["about|average|expected", "ms|millisecond", "stale|invalidation|consistency"], "minChars": 180, "maxLatencyMs": 75000 }
    },
    {
      "id": "fresh-node-lts",
      "question": "What is the latest stable Node.js LTS version right now? Link where you read it.",
      "tags": ["current information", "search-required", "evidence-sensitive"],
      "expect": { "mustCite": true, "expectTools": ["web_search"], "maxLatencyMs": 75000 }
    },
    {
      "id": "fresh-openrouter-price",
      "question": "What does OpenRouter currently charge for Claude Sonnet input tokens? Cite the page.",
      "tags": ["current information", "search-required", "evidence-sensitive"],
      "expect": { "mustCite": true, "expectTools": ["web_search"], "maxLatencyMs": 75000 }
    },
    {
      "id": "search-not-needed-binary-search",
      "question": "How does binary search work, and why is its time complexity logarithmic?",
      "tags": ["search-not-required", "code technical", "simple explanation"],
      "expect": { "mustMatch": ["sorted|order", "logarithm|log\\s*n|halv"], "expectNoTools": true, "minChars": 120, "maxLatencyMs": 75000 },
      "factualityChecks": {
        "modelInvolved": true,
        "stableWhy": "The sorted-input requirement and halving invariant of binary search are stable algorithmic properties.",
        "assertions": [
          {
            "id": "binary-search-sorted-halving",
            "claim": "Binary search relies on ordered input and halves the remaining range, producing logarithmic time.",
            "patterns": [
              "\\bbinary\\s+search\\b[\\s\\S]{0,140}\\b(?:sorted|ordered)\\b[\\s\\S]{0,100}\\b(?:array|list|sequence|range|data)\\b[\\s\\S]{0,180}\\b(?:half|halves|halve|halving|logarithmic|log\\s*n)\\b",
              "\\b(?:sorted|ordered)\\b[\\s\\S]{0,90}\\b(?:array|list|sequence|range|data)\\b[\\s\\S]{0,110}\\bbinary\\s+search\\b[\\s\\S]{0,180}\\b(?:half|halves|halve|halving|logarithmic|log\\s*n)\\b",
              "\\bbinary\\s+search\\b[\\s\\S]{0,180}\\b(?:half|halves|halve|halving|logarithmic|log\\s*n)\\b[\\s\\S]{0,180}\\b(?:sorted|ordered)\\b[\\s\\S]{0,80}\\b(?:array|list|sequence|range|data)\\b"
            ],
            "forbiddenPatterns": [
              "\\bbinary\\s+search\\b[^.!?;]{0,110}\\b(?:does not|doesn't|not)\\b[^.!?;]{0,80}\\b(?:require|need|assume)\\b[^.!?;]{0,80}\\b(?:sorted|ordered|sort)\\b",
              "\\bbinary\\s+search\\b[^.!?;]{0,160}\\b(?:linear|every element|unsorted)\\b"
            ]
          }
        ]
      }
    },
    {
      "id": "technical-code-reverse-string",
      "question": "Write a JavaScript function that reverses a string. Code only.",
      "tags": ["code technical", "search-not-required", "full-council-overkill"],
      "expect": { "mustInclude": ["reverse"], "mustMatch": ["```", "function|=>"], "expectNoTools": true, "maxLatencyMs": 40000 }
    },
    {
      "id": "ambiguous-better-question",
      "question": "Is this better?",
      "tags": ["ambiguous question", "follow-up with context"],
      "history": [
        { "role": "user", "content": "I am choosing between a fast cache and a slower database read." },
        { "role": "assistant", "content": "The better option depends on freshness requirements and whether a stale answer is acceptable." }
      ],
      "expect": { "minChars": 50, "maxLatencyMs": 75000 }
    },
    {
      "id": "follow-up-cheaper-option",
      "question": "What about the cheaper option?",
      "tags": ["follow-up with context", "moderate reasoning"],
      "history": [
        { "role": "user", "content": "Compare a managed Postgres database with a self-hosted database for a small team." },
        { "role": "assistant", "content": "Managed Postgres usually costs more in direct fees but less in operations; self-hosting can be cheaper at small scale if you already have the expertise." }
      ],
      "expect": { "mustMatch": ["self-host|managed|operations|maintenance"], "minChars": 100, "maxLatencyMs": 75000 }
    },
    {
      "id": "long-context-constraint-recall",
      "question": "Which constraints did I mention that should shape the rollout?",
      "tags": ["longer context", "follow-up with context", "evidence-sensitive"],
      "history": [
        { "role": "user", "content": "We need to keep the service within a small monthly budget and avoid a second database." },
        { "role": "assistant", "content": "That makes a managed read replica a poor first move." },
        { "role": "user", "content": "The team is only two engineers, the traffic is about 30 requests per minute, and the app must remain easy to operate." },
        { "role": "assistant", "content": "The rollout should favour low operational complexity and incremental measurement." },
        { "role": "user", "content": "We also cannot accept a stale answer for billing or account permissions, and we need a rollback path." },
        { "role": "assistant", "content": "Those paths need stronger freshness and safety guarantees than ordinary content." }
      ],
      "expect": { "mustMatch": ["budget|cost", "two engineer|small team|operat", "stale|fresh|permission|billing", "rollback"], "minChars": 180, "maxLatencyMs": 75000 }
    },
    {
      "id": "evidence-before-speed-claim",
      "question": "What evidence should I collect before claiming that a backend optimisation made the service faster?",
      "tags": ["evidence-sensitive", "moderate reasoning", "search-not-required"],
      "expect": { "mustMatch": ["baseline|before", "p50|p95|percentile", "same|representative|controlled"], "expectNoTools": true, "minChars": 180, "maxLatencyMs": 75000 }
    },
    {
      "id": "model-disagreement-value",
      "question": "If five models give nearly identical answers, when is asking more models still useful?",
      "tags": ["model disagreement", "intelligence value", "moderate reasoning"],
      "expect": { "mustMatch": ["disagree|uncertain|risk|novel|different"], "mustDiscussTradeoff": true, "minChars": 160, "maxLatencyMs": 75000 }
    },
    {
      "id": "full-council-resilience-design",
      "question": "Design an adaptive orchestration policy for an AI council that handles easy questions quickly, expands on disagreement, searches when freshness matters, and degrades safely when a provider fails. Explain the decision signals and the failure modes.",
      "tags": ["hard reasoning", "multi-step analysis", "full-council-justified", "provider resilience"],
      "expect": { "mustMatch": ["simple|easy|fast", "disagree|uncertain|confidence", "search|fresh|current", "fallback|degrad|provider"], "minChars": 280, "maxLatencyMs": 75000 }
    },
    {
      "id": "full-council-overkill-arithmetic",
      "question": "What is 17% of 340? Answer with the number.",
      "tags": ["full-council-overkill", "simple factual", "search-not-required"],
      "expect": { "mustMatch": ["\\b57\\.8\\b"], "expectNoTools": true, "maxLatencyMs": 30000 }
    },
    {
      "id": "creative-no-search",
      "question": "Write a four-line haiku about debugging a stubborn API.",
      "tags": ["creative writing", "search-not-required", "full-council-overkill"],
      "expect": { "expectNoTools": true, "minChars": 30, "maxLatencyMs": 75000 }
    },
    {
      "id": "user-text-summary-v2",
      "question": "Summarize this user-provided text in two sentences: The worker retries a failed job after a delay. A lease prevents two workers from owning the same job. If the lease expires, another worker may safely reclaim it.",
      "tags": ["user-provided text summarization", "search-not-required"],
      "expect": { "mustPreserveSummary": "worker-lease-retry-reclaim-v1", "expectNoTools": true, "minChars": 80, "maxLatencyMs": 75000 }
    },
    {
      "id": "timeless-definition-idempotency",
      "question": "Define idempotency in one paragraph with a simple API example.",
      "tags": ["simple explanation", "search-not-required", "code technical"],
      "expect": { "mustMatch": ["same|repeat|repeated", "request|operation|API"], "expectNoTools": true, "minChars": 120, "maxLatencyMs": 75000 },
      "factualityChecks": {
        "modelInvolved": true,
        "stableWhy": "Idempotency is a stable API semantics concept: repeating the same operation has the same intended effect without an additional side effect.",
        "assertions": [
          {
            "id": "idempotency-same-effect",
            "claim": "Repeating an idempotent API request or operation has the same effect without creating an additional side effect.",
            "patterns": [
              "\\bidempot(?:ent|ency)\\b[^.!?;]{0,45}\\b(?:api\\s+)?(?:operation|request)\\b[^.!?;]{0,45}\\b(?:has|gives|leaves|produces|yields)\\b[^.!?;]{0,35}\\bsame\\s+(?:effect|result|state)\\b[^.!?;]{0,60}\\b(?:repeat(?:ed|ing|s)?|again)\\b[^.!?;]{0,45}\\b(?:without|does\\s+not|doesn't|never|no)\\b[^.!?;]{0,45}\\b(?:creat\\w*\\s+(?:an?\\s+)?(?:duplicate|additional|extra)|(?:additional|duplicate|extra|another)\\s+(?:side\\s+)?effect)\\b",
              "\\brepeat(?:ing|ed|s)?\\b[^.!?;]{0,50}\\bidempot(?:ent|ency)\\b[^.!?;]{0,45}\\b(?:api\\s+)?(?:request|operation)\\b[^.!?;]{0,45}\\bsame\\s+(?:effect|result|state)\\b[^.!?;]{0,50}\\b(?:without|does\\s+not|doesn't|never|no)\\b[^.!?;]{0,45}\\b(?:creat\\w*\\s+(?:an?\\s+)?(?:duplicate|additional|extra)|(?:additional|duplicate|extra|another)\\s+(?:side\\s+)?effect)\\b",
              "\\bidempot(?:ent|ency)\\b[^.!?;]{0,35}\\b(?:means?|ensures?|describes?)\\b[^.!?;]{0,45}\\b(?:repeat(?:ing|ed|s)?|retry(?:ing|ies|ied)?|performing|executing)\\b[^.!?;]{0,50}\\b(?:same\\s+(?:effect|result|state)|unchanged)\\b[^.!?;]{0,50}\\b(?:without|does\\s+not|doesn't|never|no)\\b[^.!?;]{0,45}\\b(?:creat\\w*\\s+(?:an?\\s+)?(?:duplicate|additional|extra)|(?:additional|duplicate|extra|another)\\s+(?:side\\s+)?effect)\\b",
              "\\bidempot(?:ent|ency)\\b[^.!?;]{0,35}\\bmeans?\\b[^.!?;]{0,45}\\bperforming\\b[^.!?;]{0,50}\\b(?:same\\s+)?operation\\b[^.!?;]{0,55}\\b(?:multiple\\s+times|repeatedly|again)\\b[^.!?;]{0,65}\\b(?:leaves?|keeps?|produces?|results?\\s+in)\\b[^.!?;]{0,45}\\b(?:same\\s+(?:state|result|effect)|unchanged)\\b[^.!?;]{0,70}\\b(?:safe|without\\s+(?:a\\s+)?duplicate|no\\s+(?:additional\\s+)?effect)\\b"
            ],
            "forbiddenPatterns": [
              "\\b(?:idempotent|idempotency)\\b[^.!?;]{0,160}\\b(?:does not|doesn't|not|never)\\b[^.!?;]{0,100}\\b(?:mean|ensure|produce)\\b[^.!?;]{0,100}\\b(?:same|unchanged)\\b",
              "\\b(?:idempotent|idempotency)\\b[^.!?;]{0,150}\\b(?:creates|causes|makes)\\b[^.!?;]{0,80}\\b(?:duplicate|another|additional)\\b",
              "\\b(?:repeat(?:ed|ing|s)?|again)\\b[^.!?;]{0,70}\\b(?:idempotent|idempotency)\\b[^.!?;]{0,80}\\b(?:creates|causes|produces|makes)\\b[^.!?;]{0,60}\\bduplicate(?:s|d)?\\b",
              "\\b(?:idempotent|idempotency)\\b[^.!?;]{0,100}\\b(?:api|operation|request)\\b[^.!?;]{0,60}\\bbehav\\w*\\b[^.!?;]{0,40}\\bdifferen\\w*\\b",
              "\\b(?:idempotent|idempotency)\\b[^.!?;]{0,100}\\bmeans?\\b[^.!?;]{0,60}\\bretr(?:y|ies|ied|ying)\\b[^.!?;]{0,80}\\b(?:always|another|additional)\\b[^.!?;]{0,60}\\b(?:side\\s+effect|effect)\\b"
            ]
          }
        ]
      }
    },
    {
      "id": "fresh-weather-search",
      "question": "What is the weather in London today? Include a source link.",
      "tags": ["current information", "search-required"],
